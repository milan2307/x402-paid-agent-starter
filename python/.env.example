# Names only. Put real values in your host's environment, never in git.
# Public receive address for USDC (an address, never a private key)
X402_PAY_TO=
# Price per call in USDC, decimal string
X402_PRICE=0.01
# base or base-sepolia
X402_NETWORK=base-sepolia
# public (x402.org, base-sepolia only) or cdp (Coinbase CDP, base and base-sepolia)
X402_FACILITATOR=public
# Optional override of the facilitator URL (another public one: https://facilitator.payai.network)
X402_FACILITATOR_URL=
# Needed only when X402_FACILITATOR=cdp
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional
X402_DESCRIPTION=
PORT=8402
# Only for listing (pays the 0.01 USDC LAX listing fee). Keep it out of files.
LAX_PAYER_PRIVATE_KEY=
LAX_REGISTRY_URL=
